.lux-cta-eyebrow {
  color: rgba(200, 240, 255, 0.75);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-size: 0.75rem;
}

.lux-cta-title {
  color: #f2fbff;
  font-size: clamp(2rem, 5vw, 2.6rem);
  font-weight: 700;
  text-shadow: 0 0 22px rgba(0, 212, 255, 0.35);
}

.lux-cta .cta-svg {
  width: 1.25em;
  height: 1.25em;
  flex-shrink: 0;
  vertical-align: middle;
}

.lux-cta .cta-phone .cta-svg,
.lux-cta .cta-whatsapp .cta-svg,
.lux-cta .cta-arrow .cta-svg {
  transform: translateY(-0.05em);
}

.lux-cta .cta-whatsapp .cta-svg {
  width: 1.6em;
