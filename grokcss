/* ===============================
STATS COUNTER
================================ */
.stats-counter {
  margin: 72px auto;
  max-width: 620px;
  padding: 52px 32px 48px;
  text-align: center;
  border-radius: 32px;
  background:
    radial-gradient(
      140% 90% at 50% -20%,
      rgba(0, 212, 255, 0.25),
      transparent 60%
    ),
    linear-gradient(
      180deg,
      rgba(18, 28, 48, 0.94),
      rgba(12, 18, 32, 0.98)
    );
  backdrop-filter: blur(14px) saturate(1.15);
  -webkit-backdrop-filter: blur(14px) saturate(1.15);
  box-shadow:
    inset 0 0 0 1px rgba(255, 255, 255, 0.06),
    0 28px 70px rgba(0, 0, 0, 0.65);
  isolation: isolate;
  z-index: 2;
}

.stats-counter p:first-child {
  font-size: 0.85rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(200, 240, 255, 0.7);
  margin-bottom: 16px;
}

.stats-counter #licznik {
  font-size: clamp(3.8rem, 9vw, 5rem);
  font-weight: 800;
  letter-spacing: -0.04em;
  color: #00f0ff;
  line-height: 1;
}

.stats-counter #licznik + span {
  font-size: 0.45em;
  vertical-align: super;
  margin-left: 4px;
}

.stats-counter p:last-child {
  margin-top: 18px;
  font-size: 1.05rem;
  color: rgba(230, 240, 255, 0.75);
}

.stats-counter::after {
  content: "";
  display: block;
  width: 140px;
  height: 2px;
  margin: 32px auto 0;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(0, 212, 255, 0.75),
    transparent
  );
  box-shadow: 0 0 14px rgba(0, 212, 255, 0.45);
}

.stats-counter.is-counting {
  box-shadow:
    inset 0 0 0 1px rgba(0, 212, 255, 0.18),
    0 0 0 1px rgba(0, 212, 255, 0.25),
    0 18px 50px rgba(0, 212, 255, 0.35),
    0 0 90px rgba(0, 212, 255, 0.25);
  transform: translateY(-1px);
}

.stats-counter.is-counting .stats-number {
  text-shadow:
    0 0 12px rgba(0, 212, 255, 0.55),
    0 0 32px rgba(0, 212, 255, 0.35);
}

.stats-counter.flash-final {
  animation: counterFlash 0.45s ease-out;
}

@keyframes counterFlash {
  0% {
    box-shadow:
      inset 0 0 0 1px rgba(0, 212, 255, 0.25),
      0 0 0 1px rgba(0, 212, 255, 0.35),
      0 0 60px rgba(0, 212, 255, 0.55),
      0 0 120px rgba(0, 212, 255, 0.45);
    transform: scale(1);
  }
  45% {
    box-shadow:
      inset 0 0 0 1px rgba(0, 212, 255, 0.45),
      0 0 0 1px rgba(0, 212, 255, 0.55),
      0 0 90px rgba(0, 212, 255, 0.75),
      0 0 160px rgba(0, 212, 255, 0.55);
    transform: scale(1.015);
  }
  100% {
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.06),
      0 20px 50px rgba(0, 0, 0, 0.55);
    transform: scale(1);
  }
}

