/* Import fonts */
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap');

/* ===============================
GLOBAL STYLES
================================ */
html, body {
  max-width: 100%;
  overflow-x: hidden;
}

body {
  font-family: 'Poppins', sans-serif;
  background: #0f0f1a;
  color: #e0e0e0;
  margin: 0;
  padding-top: 56px;
}

.znachor-wrapper * {
  box-sizing: border-box;
}

.znachor-wrapper {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 14px 40px 14px;
  padding-top: 120px;
}

/* ===============================
THEME HEADER & SUMMARY
================================ */
.znachor-header {
  text-align: center;
  margin-bottom: 24px;
}

.znachor-header h1 {
  font-size: clamp(2rem, 6vw, 3rem);
  color: #00d4ff;
  text-shadow: 0 0 30px rgba(0, 212, 255, 0.4);
}

.znachor-desc {
  font-size: 1.05rem;
  color: #bbb;
}

/* ===============================
FIXED HEADER (WITH SCROLL ANIMATION)
================================ */
.robo-header {
  position: fixed;
  inset: 0 0 auto 0;
  z-index: 9999;
  overflow: visible;
  height: 56px;
  backdrop-filter: blur(10px);
  background: rgba(10, 10, 20, 0.92);
  transition: height 0.3s ease;
}

.robo-header.is-scrolled {
  height: 64px;
  backdrop-filter: blur(10px);
  background: rgba(10, 10, 20, 0.92);
}

.robo-header.is-scrolled .robo-header-inner {
  height: 64px;
}

.robo-header.is-scrolled .robo-nav a {
  padding: 7px 14px;
  font-size: 0.9rem;
}

.robo-header::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -40px;
  height: 40px;
  pointer-events: none;
  background: linear-gradient(
    to bottom,
    rgba(15, 15, 26, 0.95),
    rgba(15, 15, 26, 0)
  );
}

.robo-header-inner {
  position: relative;
  height: 56px;
}

.robo-container {
  max-width: 680px;
  margin: 0 auto;
  height: 100%;
  display: flex;
  align-items: center;
}

.robo-nav {
  display: flex !important;
  gap: 8px;
  z-index: 3;
  max-width: 520px;
}

.robo-nav a {
  position: relative;
  overflow: hidden;
  text-decoration: none !important;
  color: #e6f9ff !important;
  background: rgba(26, 26, 46, 0.75);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.03);
  opacity: 1;
  transform: none;
  pointer-events: auto;
  padding: 6px 14px;
  border-radius: 999px;
  backdrop-filter: blur(8px);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.02),
    0 6px 18px rgba(0, 0, 0, 0.35);
  font-size: 0.9rem;
  transition:
    background 0.25s ease,
    box-shadow 0.25s ease,
    transform 0.25s ease;
}

.robo-nav a:hover {
  color: #00ffea !important;
  background: rgba(0, 212, 255, 0.22);
  box-shadow:
    0 0 18px rgba(0, 212, 255, 0.45),
    inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  transform: translateY(-1px);
}

.robo-nav a.active {
  color: #00ffea !important;
  background: rgba(0, 212, 255, 0.35);
  box-shadow:
    0 0 22px rgba(0, 212, 255, 0.45),
    inset 0 0 0 1px rgba(255, 255, 255, 0.08);
}

.robo-nav a::after {
  content: '';
  position: absolute;
  left: 14px;
  right: 14px;
  bottom: 6px;
  height: 2px;
  border-radius: 2px;
  background: linear-gradient(
    90deg,
    #00d4ff,
    #00ffea
  );
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.28s ease;
}

.robo-nav a:hover::after {
  transform: scaleX(1);
}

.robo-nav a.active::after {
  transform: scaleX(1);
  box-shadow: 0 0 10px rgba(0, 212, 255, 0.6);
}

.robo-nav a:hover,
.robo-nav a:focus {
  text-decoration: none !important;
}

.robo-header,
.robo-header * {
  font-family: 'Poppins', sans-serif !important;
  line-height: 1.2;
  letter-spacing: 0;
}

.robo-logo {
  display: block !important;
  position: absolute;
  right: 10px;
  top: 50%;
  transform: translateY(1%);
  z-index: 2;
}

.robo-logo img {
  max-height: 150px;
  filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.5));
}

.robo-header:not(.is-scrolled) {
  transition: height 0.3s ease;
}

header.wp-block-template-part {
  background: transparent !important;
  box-shadow: none !important;
  border: none !important;
}

header.wp-block-template-part::before,
header.wp-block-template-part::after {
  display: none !important;
}

/* ===============================
ZNACHOR CARD (PREMIUM LUX LOOK)
================================ */
.znachor-card {
  position: relative;
  overflow: hidden;
  margin-bottom: 36px;
  padding: 40px 36px 44px;
  border-radius: 32px;
  background:
    radial-gradient(
      120% 140% at 50% 0%,
      rgba(0, 212, 255, 0.15),
      rgba(0, 0, 0, 0) 70%
    ),
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.08),
      rgba(255, 255, 255, 0.03) 30%,
      rgba(0, 0, 0, 0.6)
    ),
    linear-gradient(
      180deg,
      rgba(20, 28, 48, 0.94),
      rgba(10, 16, 30, 0.98)
    );
  border: 1px solid rgba(0, 212, 255, 0.25);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.12),
    inset 0 0 0 1px rgba(255, 255, 255, 0.05),
    0 25px 60px rgba(0, 0, 0, 0.65),
    0 0 50px rgba(0, 212, 255, 0.15);
  backdrop-filter: blur(10px) saturate(1.2);
  -webkit-backdrop-filter: blur(10px) saturate(1.2);
  transition: all 0.4s ease;
}

.znachor-card:hover,
.znachor-card:focus-within {
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.18),
    inset 0 0 0 1px rgba(0, 212, 255, 0.25),
    0 30px 80px rgba(0, 0, 0, 0.75),
    0 0 80px rgba(0, 212, 255, 0.25);
  transform: translateY(-2px);
}

.znachor-card h1,
.znachor-card h2 {
  color: #eaf6ff;
  font-family: 'Poppins', sans-serif;
  letter-spacing: -0.02em;
  margin-bottom: 16px;
}

.znachor-card h1 {
  font-size: clamp(2.4rem, 6vw, 3.2rem);
  font-weight: 700;
}

.znachor-card h2 {
  font-size: 1.8rem;
  font-weight: 600;
}

.znachor-card p,
.znachor-card li {
  color: rgba(234, 246, 255, 0.9);
  font-size: 1.1rem;
  line-height: 1.75;
}

.znachor-card strong {
  color: #ffffff;
}

.znachor-card ul {
  margin-top: 20px;
  padding-left: 24px;
}

.znachor-card li {
  margin-bottom: 12px;
}

/* ===============================
CONTACT FORM STYLES (CONTACT PAGE ONLY)
================================ */
.page-contact .znachor-form-inner input,
.page-contact .znachor-form-inner textarea {
  width: 100%;
  padding: 18px 20px;
  margin-bottom: 16px;
  background:
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.06),
      rgba(0, 0, 0, 0.4)
    );
  border: 1px solid rgba(0, 212, 255, 0.4);
  border-radius: 16px;
  color: #fff;
  font-size: 1.05rem;
  transition: all 0.3s ease;
}

.page-contact .znachor-form-inner input::placeholder,
.page-contact .znachor-form-inner textarea::placeholder {
  color: #a0a0a0;
}

.page-contact .znachor-form-inner input:focus,
.page-contact .znachor-form-inner textarea:focus {
  border-color: #00d4ff;
  background:
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.1),
      rgba(0, 0, 0, 0.5)
    );
  box-shadow:
    0 0 0 2px rgba(0, 212, 255, 0.3),
    0 0 20px rgba(0, 212, 255, 0.2);
  outline: none;
}

.page-contact .znachor-form-inner textarea {
  min-height: 140px;
  resize: vertical;
}

/* ===============================
CHOICE CARDS (CONTACT PAGE ONLY)
================================ */
.page-contact .zn-choice-wrapper {
  display: grid;
  gap: 14px;
  margin: 10px 0 16px;
}

.page-contact .zn-choice {
  position: relative;
  display: flex;
  align-items: center;
  padding: 20px 18px;
  border-radius: 18px;
  background:
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.08),
      rgba(0, 0, 0, 0.4)
    );
  border: 1px solid rgba(0, 212, 255, 0.3);
  cursor: pointer;
  transition: all 0.3s ease;
}

.page-contact .zn-choice:hover {
  border-color: #00d4ff;
  background:
    linear-gradient(
      180deg,
      rgba(0, 212, 255, 0.1),
      rgba(0, 0, 0, 0.5)
    );
  box-shadow:
    0 0 0 2px rgba(0, 212, 255, 0.3),
    0 6px 18px rgba(0, 212, 255, 0.2);
}

.page-contact .zn-choice:has(input:checked) {
  background:
    linear-gradient(
      180deg,
      rgba(0, 212, 255, 0.15),
      rgba(0, 0, 0, 0.6)
    );
  border-color: #00d4ff;
  box-shadow:
    0 0 0 2px rgba(0, 212, 255, 0.4),
    0 8px 24px rgba(0, 212, 255, 0.3);
}

.page-contact .zn-choice:has(input:checked)::after {
  content: "✓";
  position: absolute;
  top: 50%;
  right: 18px;
  transform: translateY(-50%);
  font-size: 1.1rem;
  font-weight: 700;
  color: #00d4ff;
}

.page-contact .zn-choice input[type="radio"] {
  appearance: none;
  -webkit-appearance: none;
  -moz-appearance: none;
  position: absolute;
  inset: 0;
  width: 0;
  height: 0;
  margin: 0;
  padding: 0;
  border: 0;
  opacity: 0;
  pointer-events: none;
}

.page-contact .zn-choice-title {
  font-size: 1.1rem;
  font-weight: 600;
  line-height: 1.3;
  color: #fff;
}

/* ===============================
SUBMIT BUTTON (CONTACT PAGE ONLY)
================================ */
.page-contact .zn-btn {
  width: 100%;
  margin-top: 20px;
  height: 60px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border-radius: 40px;
  font-size: 1.15rem;
  font-weight: 700;
  color: #000;
  background: linear-gradient(90deg, #00d4ff, #00ffea);
  border: none;
  cursor: pointer;
  transition: all 0.3s ease;
}

.page-contact .zn-btn:hover {
  transform: translateY(-3px);
  box-shadow:
    0 14px 36px rgba(0, 212, 255, 0.5),
    0 0 40px rgba(0, 212, 255, 0.3);
}

.page-contact .zn-btn-text {
  display: flex;
  align-items: center;
}

.page-contact .zn-btn-arrow {
  font-size: 1.8em;
  line-height: 1;
  display: flex;
  align-items: center;
  transform: translateY(-1px);
  transition: transform 0.3s ease;
}

.page-contact .zn-btn:hover .zn-btn-arrow {
  transform: translate(15px, -1px);
}

/* ===============================
